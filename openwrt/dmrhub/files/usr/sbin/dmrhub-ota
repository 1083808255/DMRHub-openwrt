#!/bin/sh
# DMRHub application and firmware OTA updater for OpenWrt.
#
# The version manifest is published with every GitHub release of the firmware
# repository. It names the application package and the firmware image plus
# their SHA256 sums, so this script can verify what it downloads before it
# writes anything to flash.
#
# Usage:
#   dmrhub-ota check              # report whether an update is available
#   dmrhub-ota status             # same, as JSON for the LuCI page
#   dmrhub-ota app [--force]      # install the application package (ipk)
#   dmrhub-ota firmware [--yes]   # flash the firmware image (reboots)
#   dmrhub-ota job start app|firmware [args...]
#                                 # run an update in the background, return now
#   dmrhub-ota job status         # JSON progress of the background job
#
# The LuCI page calls job start/job status: every layer between the browser
# and this script (LuCI RPC, cgi-io ubus) caps a synchronous call at ~20-30s,
# while a proxy download of the image takes a minute or more. A background job
# sidesteps all of those caps.
set -eu

REPO="${DMRHUB_OTA_REPO:-1083808255/DMRHub-openwrt}"
GITEE_REPO="${DMRHUB_OTA_GITEE_REPO:-xyinmaster/DMRHub-ota}"
GITEE_BRANCH="${DMRHUB_OTA_GITEE_BRANCH:-master}"

# Gitee carries the OTA releases: github.com is unreachable from many networks
# here, and Gitee answers on the same continent. CI rewrites version.json in
# that repository on every release, so this URL always names the newest build.
GITEE_MANIFEST_URL="https://gitee.com/$GITEE_REPO/raw/$GITEE_BRANCH/version.json"
# The GitHub copy stays as the second source, for networks where Gitee is the
# one that is slow or blocked.
MANIFEST_URL="${DMRHUB_OTA_MANIFEST:-https://github.com/$REPO/releases/latest/download/version.json}"
# Extra sources to try when the first two cannot be reached.
MIRROR_URL="${DMRHUB_OTA_MIRROR_SOURCE:-}"
# Which host served the manifest; the assets are taken from the same one.
MANIFEST_HOST=""

# github.com is not reachable from every network: DNS answers and ICMP get
# through, but the TLS handshake is reset, so every download fails with
# "Operation not permitted" or a timeout. These proxies take a full GitHub URL
# after the prefix and are tried only after the direct download fails. Set
# "option ota_mirror" in /etc/config/dmrhub, or DMRHUB_OTA_MIRROR for one run;
# either accepts a space separated list, and "none" disables them.
DEFAULT_MIRROR="https://gh-proxy.com"

VERSION_DIR="/opt/dmrhub"
VERSION_FILE="$VERSION_DIR/version"
MANIFEST="/tmp/dmrhub-version.json"
APP_FILE="/tmp/dmrhub-app.ipk"
FW_FILE="/tmp/dmrhub-fw.img.gz"

# Background job state, polled by the LuCI page while an update runs.
JOB_DIR="/tmp/dmrhub-ota-job"
JOB_STATE="$JOB_DIR/state"
JOB_LOG="$JOB_DIR/log"
JOB_KIND="$JOB_DIR/kind"

LOCAL_VERSION="none"
LOCAL_LABEL="none"

# The build tag is the identity of a build: the manifest names it as
# "build_tag" and the binary reports it as its version, so the two can be
# compared without a separate file to keep in sync.
if [ -x /usr/bin/dmrhub ]; then
	# The binary prints "DMRHub version <build tag> - <commit>". Pick the
	# token that ends in the commit hash, which is the build tag.
	LOCAL_VERSION=$(/usr/bin/dmrhub --version 2>/dev/null |
		awk '{ for (i = 1; i <= NF; i++) if ($i ~ /-[0-9a-f]+$/ && length($i) > 8) { print $i; exit } }')
fi
if [ -z "$LOCAL_VERSION" ] && [ -f "$VERSION_FILE" ]; then
	LOCAL_VERSION=$(cat "$VERSION_FILE" 2>/dev/null || echo none)
fi
[ -n "$LOCAL_VERSION" ] || LOCAL_VERSION="none"
LOCAL_LABEL="$LOCAL_VERSION"

# status is read by the LuCI page, which parses its stdout, so its progress
# lines would end up in front of the JSON. QUIET keeps them off stdout.
log() {
	[ -n "${QUIET:-}" ] && return 0
	echo "[dmrhub-ota] $*"
}
die() { echo "[dmrhub-ota] 错误：$*" >&2; exit 1; }

# _fetch_once <url> <outfile> - one download with whatever the image provides.
_fetch_once() {
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q --timeout=30 -O "$2" "$1" && return 0
	fi
	if command -v wget >/dev/null 2>&1; then
		wget -q -T 30 -O "$2" "$1" && return 0
	fi
	return 1
}

# mirrors - the proxy list, from the environment, uci, or the built-in default.
mirrors() {
	if [ -n "${DMRHUB_OTA_MIRROR:-}" ]; then
		_list="$DMRHUB_OTA_MIRROR"
	else
		_list="$(uci -q get dmrhub.main.ota_mirror 2>/dev/null || true)"
		[ -n "$_list" ] || _list="$DEFAULT_MIRROR"
	fi
	[ "$_list" = "none" ] && _list=""
	echo "$_list"
}

# The mirror that worked for this run, so the asset downloads do not each pay
# for another direct attempt that is known to fail.
PREFERRED_MIRROR=""

# fetch <url> <outfile> - download, falling back to a proxy for github.com.
fetch() {
	_url="$1"
	_out="$2"
	if [ -n "$PREFERRED_MIRROR" ] && _fetch_once "$PREFERRED_MIRROR/$_url" "$_out"; then
		return 0
	fi
	if _fetch_once "$_url" "$_out"; then
		return 0
	fi
	# The Gitee copy of a large asset is best effort: the build uploads it only
	# while it fits in the runner's budget. Every release has a GitHub copy, so
	# that one is tried next, directly and then through a proxy.
	case "$_url" in
	https://gitee.com/"$GITEE_REPO"/releases/download/*)
		_alt="https://github.com/$REPO/${_url#https://gitee.com/$GITEE_REPO/}"
		log "Gitee 下载失败，改用 GitHub：$_alt"
		if _fetch_once "$_alt" "$_out"; then
			return 0
		fi
		_url="$_alt"
		;;
	esac
	case "$_url" in
	https://github.com/*) ;;
	*) return 1 ;;
	esac
	for _m in $(mirrors); do
		[ -n "$_m" ] || continue
		[ "$_m" = "$PREFERRED_MIRROR" ] && continue
		log "直连 GitHub 失败，改用镜像：$_m"
		if _fetch_once "$_m/$_url" "$_out"; then
			PREFERRED_MIRROR="$_m"
			return 0
		fi
	done
	return 1
}

# json <expr> - read one value out of the manifest.
json() {
	jsonfilter -i "$MANIFEST" -e "$1" 2>/dev/null || true
}

# load_manifest - put the newest manifest in $MANIFEST.
load_manifest() {
	_ok=0
	MANIFEST_HOST=""
	for _base in "$GITEE_MANIFEST_URL" "$MANIFEST_URL" "$MIRROR_URL"; do
		[ -n "$_base" ] || continue
		log "正在获取版本清单：$_base"
		if fetch "$_base" "$MANIFEST" && [ -s "$MANIFEST" ]; then
			case "$_base" in
			*gitee.com*) MANIFEST_HOST="gitee" ;;
			*) MANIFEST_HOST="github" ;;
			esac
			_ok=1
			break
		fi
	done
	[ "$_ok" = 1 ] || die "无法从任何源获取版本清单，请检查设备网络连接"
	# A manifest without a version field is not usable.
	[ -n "$(json '@.version')" ] || die "版本清单缺少 version 字段"
}

# resolve_url <file-field> <url-field> - an absolute URL for a release asset.
resolve_url() {
	_file_field="$1"
	_url_field="$2"
	_file="$(json "@.$_file_field")"
	_tag="$(json '@.release_tag')"
	[ -n "$_tag" ] || _tag="$(json '@.build_tag')"
	# CI decides per asset whether the Gitee copy exists, because a large
	# upload from its runner does not always finish, and it writes the choice
	# into the manifest. Without a URL, assume the asset sits with the
	# manifest.
	_url="$(json "@.$_url_field")"
	if [ -n "$_url" ]; then
		echo "$_url"
		return 0
	fi
	[ -n "$_file" ] || return 1
	[ -n "$_tag" ] || return 1
	if [ "$MANIFEST_HOST" = "gitee" ]; then
		echo "https://gitee.com/$GITEE_REPO/releases/download/$_tag/$_file"
		return 0
	fi
	_release="$(json '@.release_url')"
	case "$_release" in
	*/releases/tag/*)
		# The release URL ends in the tag, but the assets live under
		# /download/, so swap that segment instead of trimming it.
		echo "${_release%%/tag/*}/download/$_file"
		return 0
		;;
	esac
	_tag="$(json '@.release_tag')"
	[ -n "$_tag" ] || _tag="$(json '@.build_tag')"
	echo "https://github.com/$REPO/releases/download/$_tag/$_file"
}

REMOTE_VERSION=""
REMOTE_TAG=""
REMOTE_APP_URL=""
REMOTE_FW_URL=""
REMOTE_APP_SHA=""
REMOTE_FW_SHA=""

load_release() {
	load_manifest
	REMOTE_VERSION="$(json '@.version')"
	REMOTE_TAG="$(json '@.build_tag')"
	REMOTE_APP_SHA="$(json '@.app_sha256')"
	REMOTE_FW_SHA="$(json '@.firmware_sha256')"
	REMOTE_APP_URL="$(resolve_url app_file app_url || true)"
	REMOTE_FW_URL="$(resolve_url firmware_file firmware_url || true)"
}

# up_to_date - true when the running build is the one the manifest names.
up_to_date() {
	[ -n "$REMOTE_TAG" ] || return 1
	[ "$LOCAL_VERSION" = "$REMOTE_TAG" ] && return 0
	# Fall back to the commit hash, which both the build tag and the version
	# end in, so a change in the tag format does not report a false update.
	_local_commit="${LOCAL_VERSION##*-}"
	_remote_commit="${REMOTE_TAG##*-}"
	[ -n "$_local_commit" ] && [ "$_local_commit" = "$_remote_commit" ]
}

save_version() {
	mkdir -p "$VERSION_DIR" 2>/dev/null || true
	echo "$1" > "$VERSION_FILE" 2>/dev/null || true
}

# feed_line - the opkg feed line. It goes through the configured mirror when
# there is one, because an install on a network that blocks github.com could
# otherwise never see a package update.
feed_line() {
	_base="https://github.com/$REPO/releases/latest/download"
	for _m in $(mirrors); do
		[ -n "$_m" ] || continue
		_base="$_m/$_base"
		break
	done
	echo "src/gz dmrhub $_base"
}

# apply_feed - put that line into customfeeds.conf, leaving every other feed
# and the comments untouched.
apply_feed() {
	_line="$(feed_line)"
	_conf="/etc/opkg/customfeeds.conf"
	_tmp="/tmp/customfeeds.conf.$$"
	mkdir -p /etc/opkg
	[ -f "$_conf" ] || : > "$_conf"
	grep -v '^src/gz dmrhub ' "$_conf" > "$_tmp" 2>/dev/null || true
	printf '%s\n' "$_line" >> "$_tmp"
	# Skip the rewrite when nothing changed, so a boot is not reported as a
	# configuration update.
	if cmp -s "$_tmp" "$_conf"; then
		rm -f "$_tmp"
		return 0
	fi
	mv "$_tmp" "$_conf"
}

cmd_feed() {
	if [ "${1:-}" = "--apply" ]; then
		apply_feed
	else
		feed_line
	fi
}

cmd_check() {
	load_release
	if up_to_date; then
		log "已是最新版本（$REMOTE_VERSION）"
	else
		log "发现新版本：$LOCAL_LABEL -> $REMOTE_VERSION"
	fi
}

cmd_status() {
	QUIET=1
	load_release
	if up_to_date; then
		_state="current"
	else
		_state="available"
	fi
	printf '{"local":"%s","remote":"%s","state":"%s","source":"%s","app_url":"%s","app_sha256":"%s","firmware_url":"%s","firmware_sha256":"%s"}\n' \
		"$LOCAL_LABEL" "$REMOTE_VERSION" "$_state" "$MANIFEST_HOST" \
		"$REMOTE_APP_URL" "$REMOTE_APP_SHA" "$REMOTE_FW_URL" "$REMOTE_FW_SHA"
}

cmd_app() {
	load_release
	if up_to_date && [ "${1:-}" != "--force" ]; then
		log "已是最新版本（$REMOTE_VERSION）"
		return 0
	fi
	[ -n "$REMOTE_APP_URL" ] || die "版本清单中没有应用程序包信息"
	log "正在下载应用包：$REMOTE_APP_URL"
	fetch "$REMOTE_APP_URL" "$APP_FILE" || die "下载失败"
	if [ -n "$REMOTE_APP_SHA" ]; then
		echo "$REMOTE_APP_SHA  $APP_FILE" | sha256sum -c - >/dev/null || die "SHA256 校验不通过，文件可能已损坏"
	fi
	log "正在安装应用程序包"
	opkg install --force-reinstall "$APP_FILE" || die "opkg 安装失败"
	save_version "$REMOTE_TAG"
	/etc/init.d/dmrhub restart
	log "应用程序已更新至 $REMOTE_VERSION"
}

cmd_firmware() {
	load_release
	[ -n "$REMOTE_FW_URL" ] || die "版本清单中没有固件镜像信息"
	if [ "${1:-}" != "--yes" ]; then
		log "警告：刷写固件会重启设备"
		printf "输入 yes 继续： "
		read -r ans
		[ "$ans" = "yes" ] || die "已取消"
	fi
	log "正在下载固件：$REMOTE_FW_URL"
	fetch "$REMOTE_FW_URL" "$FW_FILE" || die "下载失败"
	if [ -n "$REMOTE_FW_SHA" ]; then
		echo "$REMOTE_FW_SHA  $FW_FILE" | sha256sum -c - >/dev/null || die "SHA256 校验不通过，文件可能已损坏"
	fi
	log "正在刷写固件，设备即将重启"
	# -k keeps the current configuration, -u skips backup files that already
	# match what is in /rom.
	sysupgrade -k -u "$FW_FILE"
}

# json_escape - make a string safe to embed in a JSON double-quoted value.
json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' |
		awk 'BEGIN{ORS=""} {if(NR>1) printf "\\n"; printf "%s",$0}'
}

# cmd_job_start <app|firmware> [extra args] - spawn the real update detached
# from the HTTP request and return immediately. setsid keeps the child alive
# after fs.exec's stdin/stdout close; all output goes to the job log.
cmd_job_start() {
	_kind="${1:-}"
	case "$_kind" in
	app|firmware) ;;
	*) die "后台任务只支持 app 或 firmware" ;;
	esac
	shift
	mkdir -p "$JOB_DIR" 2>/dev/null || die "无法创建任务目录"
	# A tiny runner records state around a direct call back into this script.
	# Args are fixed (--force / --yes), so no shell-quoting of user data.
	_runner="$JOB_DIR/runner.sh"
	_args=""
	for _a in "$@"; do _args="$_args $_a"; done
	cat > "$_runner" <<EOF
#!/bin/sh
echo running > "$JOB_STATE"
echo "$_kind" > "$JOB_KIND"
"$0" __background $_kind$_args >> "$JOB_LOG" 2>&1
if [ \$? -eq 0 ]; then echo done > "$JOB_STATE"; else echo failed > "$JOB_STATE"; fi
EOF
	chmod 755 "$_runner"
	: > "$JOB_LOG"
	echo queued > "$JOB_STATE"
	if command -v setsid >/dev/null 2>&1; then
		setsid "$_runner" </dev/null >/dev/null 2>&1 &
	else
		"$_runner" </dev/null >/dev/null 2>&1 &
	fi
	log "已在后台启动 $_kind 更新；用 job status 查看进度"
}

# __background <app|firmware> [args...] - internal entry for the detached runner.
cmd_background() {
	_kind="${1:-}"
	shift
	case "$_kind" in
	app) cmd_app "$@" ;;
	firmware) cmd_firmware "$@" ;;
	*) die "未知后台任务 $_kind" ;;
	esac
}

# cmd_job_status - JSON progress for the LuCI poller.
cmd_job_status() {
	_state="idle"
	_kind=""
	_log=""
	[ -f "$JOB_STATE" ] && _state=$(cat "$JOB_STATE" 2>/dev/null || echo idle)
	[ -f "$JOB_KIND" ] && _kind=$(cat "$JOB_KIND" 2>/dev/null || echo "")
	[ -f "$JOB_LOG" ] && _log=$(tail -c 4096 "$JOB_LOG" 2>/dev/null || echo "")
	printf '{"state":"%s","kind":"%s","log":"%s"}\n' \
		"$(json_escape "$_state")" "$(json_escape "$_kind")" "$(json_escape "$_log")"
}

case "${1:-check}" in
__background)
	cmd_background "${2:-}" "${3:-}" "${4:-}"
	;;
job)
	case "${2:-status}" in
	start)
		cmd_job_start "${3:-}" "${4:-}" "${5:-}" "${6:-}"
		;;
	status)
		QUIET=1
		cmd_job_status
		;;
	*)
		echo "用法：$0 job {start app|firmware [args...]|status}"
		exit 1
		;;
	esac
	;;
check)
	cmd_check
	;;
status)
	cmd_status
	;;
app)
	cmd_app "${2:-}"
	;;
firmware)
	cmd_firmware "${2:-}"
	;;
feed)
	cmd_feed "${2:-}"
	;;
*)
	echo "用法：$0 {check|status|app|firmware|feed}"
	exit 1
	;;
esac
