#!/bin/sh
# DMRHub application and firmware OTA updater for OpenWrt.
#
# The version manifest is published with every GitHub release of the firmware
# repository. It names the application package and the firmware image plus
# their SHA256 sums, so this script can verify what it downloads before it
# writes anything to flash.
#
# Usage:
#   dmrhub-ota check              # report whether an update is available
#   dmrhub-ota status             # same, as JSON for the LuCI page
#   dmrhub-ota app [--force]      # install the application package (ipk)
#   dmrhub-ota firmware [--yes]   # flash the firmware image (reboots)
set -eu

REPO="${DMRHUB_OTA_REPO:-1083808255/DMRHub-openwrt}"
# The manifest lives next to the release assets; "latest" always points at the
# newest release, so the script needs no configuration after an install.
MANIFEST_URL="${DMRHUB_OTA_MANIFEST:-https://github.com/$REPO/releases/latest/download/version.json}"
# Extra sources to try when the first one cannot be reached. Empty by default:
# the Gitee mirror this script used to fall back on no longer exists.
MIRROR_URL="${DMRHUB_OTA_MIRROR:-}"

# github.com is not reachable from every network: DNS answers and ICMP get
# through, but the TLS handshake is reset, so every download fails with
# "Operation not permitted" or a timeout. These proxies take a full GitHub URL
# after the prefix and are tried only after the direct download fails. Set
# "option ota_mirror" in /etc/config/dmrhub, or DMRHUB_OTA_MIRROR for one run;
# either accepts a space separated list, and "none" disables them.
DEFAULT_MIRROR="https://gh-proxy.com"

VERSION_DIR="/opt/dmrhub"
VERSION_FILE="$VERSION_DIR/version"
MANIFEST="/tmp/dmrhub-version.json"
APP_FILE="/tmp/dmrhub-app.ipk"
FW_FILE="/tmp/dmrhub-fw.img.gz"

LOCAL_VERSION="none"
LOCAL_LABEL="none"

# The build tag is the identity of a build: the manifest names it as
# "build_tag" and the binary reports it as its version, so the two can be
# compared without a separate file to keep in sync.
if [ -x /usr/bin/dmrhub ]; then
	# The binary prints "DMRHub version <build tag> - <commit>". Pick the
	# token that ends in the commit hash, which is the build tag.
	LOCAL_VERSION=$(/usr/bin/dmrhub --version 2>/dev/null |
		awk '{ for (i = 1; i <= NF; i++) if ($i ~ /-[0-9a-f]+$/ && length($i) > 8) { print $i; exit } }')
fi
if [ -z "$LOCAL_VERSION" ] && [ -f "$VERSION_FILE" ]; then
	LOCAL_VERSION=$(cat "$VERSION_FILE" 2>/dev/null || echo none)
fi
[ -n "$LOCAL_VERSION" ] || LOCAL_VERSION="none"
LOCAL_LABEL="$LOCAL_VERSION"

log() { echo "[dmrhub-ota] $*"; }
die() { echo "[dmrhub-ota] 错误：$*" >&2; exit 1; }

# _fetch_once <url> <outfile> - one download with whatever the image provides.
_fetch_once() {
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q --timeout=30 -O "$2" "$1" && return 0
	fi
	if command -v wget >/dev/null 2>&1; then
		wget -q -T 30 -O "$2" "$1" && return 0
	fi
	return 1
}

# mirrors - the proxy list, from the environment, uci, or the built-in default.
mirrors() {
	if [ -n "${DMRHUB_OTA_MIRROR:-}" ]; then
		_list="$DMRHUB_OTA_MIRROR"
	else
		_list="$(uci -q get dmrhub.main.ota_mirror 2>/dev/null || true)"
		[ -n "$_list" ] || _list="$DEFAULT_MIRROR"
	fi
	[ "$_list" = "none" ] && _list=""
	echo "$_list"
}

# The mirror that worked for this run, so the asset downloads do not each pay
# for another direct attempt that is known to fail.
PREFERRED_MIRROR=""

# fetch <url> <outfile> - download, falling back to a proxy for github.com.
fetch() {
	_url="$1"
	_out="$2"
	if [ -n "$PREFERRED_MIRROR" ] && _fetch_once "$PREFERRED_MIRROR/$_url" "$_out"; then
		return 0
	fi
	if _fetch_once "$_url" "$_out"; then
		return 0
	fi
	case "$_url" in
	https://github.com/*) ;;
	*) return 1 ;;
	esac
	for _m in $(mirrors); do
		[ -n "$_m" ] || continue
		[ "$_m" = "$PREFERRED_MIRROR" ] && continue
		log "直连 GitHub 失败，改用镜像：$_m"
		if _fetch_once "$_m/$_url" "$_out"; then
			PREFERRED_MIRROR="$_m"
			return 0
		fi
	done
	return 1
}

# json <expr> - read one value out of the manifest.
json() {
	jsonfilter -i "$MANIFEST" -e "$1" 2>/dev/null || true
}

# load_manifest - put the newest manifest in $MANIFEST.
load_manifest() {
	_ok=0
	for _base in "$MANIFEST_URL" "$MIRROR_URL"; do
		[ -n "$_base" ] || continue
		log "正在获取版本清单：$_base"
		if fetch "$_base" "$MANIFEST" && [ -s "$MANIFEST" ]; then
			_ok=1
			break
		fi
	done
	[ "$_ok" = 1 ] || die "无法从任何源获取版本清单，请检查设备网络连接"
	# A manifest without a version field is not usable.
	[ -n "$(json '@.version')" ] || die "版本清单缺少 version 字段"
}

# resolve_url <file-field> <url-field> - an absolute URL for a release asset.
resolve_url() {
	_file_field="$1"
	_url_field="$2"
	_url="$(json "@.$_url_field")"
	if [ -n "$_url" ]; then
		echo "$_url"
		return 0
	fi
	_file="$(json "@.$_file_field")"
	[ -n "$_file" ] || return 1
	_release="$(json '@.release_url')"
	case "$_release" in
	*/releases/tag/*)
		# The release URL ends in the tag, but the assets live under
		# /download/, so swap that segment instead of trimming it.
		echo "${_release%%/tag/*}/download/$_file"
		return 0
		;;
	esac
	_tag="$(json '@.release_tag')"
	[ -n "$_tag" ] || _tag="$(json '@.build_tag')"
	echo "https://github.com/$REPO/releases/download/$_tag/$_file"
}

REMOTE_VERSION=""
REMOTE_TAG=""
REMOTE_APP_URL=""
REMOTE_FW_URL=""
REMOTE_APP_SHA=""
REMOTE_FW_SHA=""

load_release() {
	load_manifest
	REMOTE_VERSION="$(json '@.version')"
	REMOTE_TAG="$(json '@.build_tag')"
	REMOTE_APP_SHA="$(json '@.app_sha256')"
	REMOTE_FW_SHA="$(json '@.firmware_sha256')"
	REMOTE_APP_URL="$(resolve_url app_file app_url || true)"
	REMOTE_FW_URL="$(resolve_url firmware_file firmware_url || true)"
}

# up_to_date - true when the running build is the one the manifest names.
up_to_date() {
	[ -n "$REMOTE_TAG" ] || return 1
	[ "$LOCAL_VERSION" = "$REMOTE_TAG" ] && return 0
	# Fall back to the commit hash, which both the build tag and the version
	# end in, so a change in the tag format does not report a false update.
	_local_commit="${LOCAL_VERSION##*-}"
	_remote_commit="${REMOTE_TAG##*-}"
	[ -n "$_local_commit" ] && [ "$_local_commit" = "$_remote_commit" ]
}

save_version() {
	mkdir -p "$VERSION_DIR" 2>/dev/null || true
	echo "$1" > "$VERSION_FILE" 2>/dev/null || true
}

cmd_check() {
	load_release
	if up_to_date; then
		log "已是最新版本（$REMOTE_VERSION）"
	else
		log "发现新版本：$LOCAL_LABEL -> $REMOTE_VERSION"
	fi
}

cmd_status() {
	load_release
	if up_to_date; then
		_state="current"
	else
		_state="available"
	fi
	printf '{"local":"%s","remote":"%s","state":"%s","app_url":"%s","app_sha256":"%s","firmware_url":"%s","firmware_sha256":"%s"}\n' \
		"$LOCAL_LABEL" "$REMOTE_VERSION" "$_state" \
		"$REMOTE_APP_URL" "$REMOTE_APP_SHA" "$REMOTE_FW_URL" "$REMOTE_FW_SHA"
}

cmd_app() {
	load_release
	if up_to_date && [ "${1:-}" != "--force" ]; then
		log "已是最新版本（$REMOTE_VERSION）"
		return 0
	fi
	[ -n "$REMOTE_APP_URL" ] || die "版本清单中没有应用程序包信息"
	log "正在下载应用包：$REMOTE_APP_URL"
	fetch "$REMOTE_APP_URL" "$APP_FILE" || die "下载失败"
	if [ -n "$REMOTE_APP_SHA" ]; then
		echo "$REMOTE_APP_SHA  $APP_FILE" | sha256sum -c - >/dev/null || die "SHA256 校验不通过，文件可能已损坏"
	fi
	log "正在安装应用程序包"
	opkg install --force-reinstall "$APP_FILE" || die "opkg 安装失败"
	save_version "$REMOTE_TAG"
	/etc/init.d/dmrhub restart
	log "应用程序已更新至 $REMOTE_VERSION"
}

cmd_firmware() {
	load_release
	[ -n "$REMOTE_FW_URL" ] || die "版本清单中没有固件镜像信息"
	if [ "${1:-}" != "--yes" ]; then
		log "警告：刷写固件会重启设备"
		printf "输入 yes 继续： "
		read -r ans
		[ "$ans" = "yes" ] || die "已取消"
	fi
	log "正在下载固件：$REMOTE_FW_URL"
	fetch "$REMOTE_FW_URL" "$FW_FILE" || die "下载失败"
	if [ -n "$REMOTE_FW_SHA" ]; then
		echo "$REMOTE_FW_SHA  $FW_FILE" | sha256sum -c - >/dev/null || die "SHA256 校验不通过，文件可能已损坏"
	fi
	log "正在刷写固件，设备即将重启"
	# -k keeps the current configuration, -u skips backup files that already
	# match what is in /rom.
	sysupgrade -k -u "$FW_FILE"
}

case "${1:-check}" in
check)
	cmd_check
	;;
status)
	cmd_status
	;;
app)
	cmd_app "${2:-}"
	;;
firmware)
	cmd_firmware "${2:-}"
	;;
*)
	echo "用法：$0 {check|status|app|firmware}"
	exit 1
	;;
esac
