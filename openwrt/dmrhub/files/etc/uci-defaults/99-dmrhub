#!/bin/sh
# First-boot setup for DMRHub
[ -f /etc/config/dmrhub ] || exit 0
mkdir -p /opt/dmrhub/data
chmod 755 /opt/dmrhub

# Add the DMRHub release feed to opkg. The line follows "option ota_mirror",
# so an install on a network that blocks github.com can still fetch packages;
# the signing key in /etc/opkg/keys keeps "option check_signature" meaningful
# for this feed too.
if ! /usr/sbin/dmrhub-ota feed --apply 2>/dev/null; then
	FEED="src/gz dmrhub https://github.com/1083808255/DMRHub-openwrt/releases/latest/download"
	if [ -f /etc/opkg/customfeeds.conf ]; then
		grep -q '^src/gz dmrhub ' /etc/opkg/customfeeds.conf || echo "$FEED" >> /etc/opkg/customfeeds.conf
	else
		echo "$FEED" > /etc/opkg/customfeeds.conf
	fi
fi

# The LuCI "Backup / Flash Firmware" OTA buttons call dmrhub-ota through
# ubus (fs.exec). rpcd's default 30s timeout is shorter than a proxy
# download of the 30 MB ipk / 38 MB image, so the call is killed mid-transfer
# and the page reports an update failure. Raise the cap so the whole update
# can finish. Applied on first boot and on every sysupgrade that keeps this
# file, so existing devices get it too.
if command -v uci >/dev/null 2>&1; then
	CURRENT_TIMEOUT=$(uci -q get rpcd.@rpcd[0].timeout 2>/dev/null)
	[ -n "$CURRENT_TIMEOUT" ] || exit 0
	if [ "$CURRENT_TIMEOUT" -lt 600 ]; then
		uci set rpcd.@rpcd[0].timeout=600
		uci commit rpcd
	fi
fi
exit 0
