#!/bin/sh /etc/rc.common
# DMRHub init script for OpenWrt procd
START=95
STOP=10
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="        status  Show DMRHub run status"

CONF_DIR=/opt/dmrhub
BIN=/usr/bin/dmrhub
DB_PROTECT=/usr/sbin/dmrhub-db-protect

# DMRHub keeps all of its state on the dedicated data partition, never on the
# rootfs overlay: the database is large, the rootfs is small, and a flash of
# the firmware erases the overlay. init.d/dmrhub-data creates and mounts that
# partition (START=15) before this script runs (START=95). Without it there is
# nowhere safe to write, so the service stays stopped instead of silently
# filling the overlay.
data_partition_mounted() {
    local src
    src=$(awk '$2 == "/opt/dmrhub" && $3 == "ext4" { print $1; exit }' /proc/mounts)
    case "$src" in
        /dev/*) return 0 ;;
    esac
    return 1
}

start_service() {
    if ! data_partition_mounted; then
        logger -t dmrhub "数据分区 /opt/dmrhub 未挂载，拒绝启动（不允许使用 overlay）"
        return 1
    fi

    refreshOpkgFeed
    installLuciFlashView
    installLuciOverview

    # Ensure persistent data/config directory exists
    mkdir -p "$CONF_DIR/data"

    # A version of the package before the fix kept the database in the root
    # of the filesystem, because the service did not read the config file.
    # Move that database, and its log, to the place the config file names.
    if [ ! -f "$CONF_DIR/data/DMRHub.db" ] && [ -f /DMRHub.db ]; then
        mv /DMRHub.db "$CONF_DIR/data/DMRHub.db" 2>/dev/null
        mv /DMRHub.db-wal "$CONF_DIR/data/DMRHub.db-wal" 2>/dev/null
        rm -f /DMRHub.db-shm
    fi

    # Seed a usable config on first run. DMRHub reads the file that the
    # --config flag names, so it finds it no matter the working directory
    # of the process.
    if [ ! -f "$CONF_DIR/config.yaml" ]; then
        cat > "$CONF_DIR/config.yaml" <<EOF
log-level: "info"
database:
  driver: "sqlite"
  database: "$CONF_DIR/data/DMRHub.db"
  extra-parameters: ["_pragma=foreign_keys(1)", "_pragma=journal_mode(WAL)", "_pragma=synchronous(FULL)"]
http:
  bind: "[::]"
  port: 3005
EOF
    fi

    # Older images shipped synchronous(NORMAL), which can lose the newest
    # commits after an unclean shutdown. The binary now forces FULL, so keep
    # the config file truthful as well.
    sed -i 's/_pragma=synchronous(NORMAL)/_pragma=synchronous(FULL)/g' \
        "$CONF_DIR/config.yaml" 2>/dev/null || true

    # Check the database before procd starts the writer. A damaged file is
    # preserved and restored from the verified snapshot; if even that fails,
    # no instance is created and the service stays stopped.
    if [ -x "$DB_PROTECT" ]; then
        "$DB_PROTECT" startup || {
            logger -t dmrhub "数据库保护失败，拒绝启动 DMRHub"
            return 1
        }
    fi

    # DMRHub makes the secret and the password salt itself and keeps them
    # in the database, so the config file must not set them. A config file
    # of an older version holds placeholders; drop them, so the values in
    # the database stay in use and the passwords of the accounts keep
    # working.
    sed -i -e '/^secret:.*change-me/d' -e '/^password-salt:.*change-me/d' \
        "$CONF_DIR/config.yaml"

    # procd of OpenWrt 24.10 has no parameter for the working directory, so
    # the service changes it itself. DMRHub looks for ./config.yaml in its
    # working directory, and the flag names the same file, so it finds the
    # config no matter how the process was started.
    procd_open_instance dmrhub
    procd_set_param command /bin/sh -c "cd $CONF_DIR && exec $BIN --config $CONF_DIR/config.yaml"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    # A graceful stop needs time: DMRHub waits for the calls in progress
    # before it closes the database. Five seconds of the procd default
    # SIGKILLed it mid write and corrupted the database at an OTA. A full
    # minute also covers a busy hub whose upstream servers take longer to
    # unwind than a single voice burst.
    procd_set_param term_timeout 60
    procd_close_instance
}

# service_stopped runs after procd has killed the instance. The writer is gone
# now, so checkpoint the WAL and refresh the known-good snapshot. If this
# fails, the next start will repair from the previous snapshot.
service_stopped() {
    [ -x "$DB_PROTECT" ] || return 0
    "$DB_PROTECT" snapshot || logger -t dmrhub "数据库快照失败，下次启动将尝试恢复"
}

# refreshOpkgFeed keeps the DMRHub feed on the mirror "option ota_mirror"
# names, so changing that option takes effect at the next start instead of
# only on a fresh install.
refreshOpkgFeed() {
    [ -x /usr/sbin/dmrhub-ota ] || return 0
    /usr/sbin/dmrhub-ota feed --apply 2>/dev/null || true
}

# installLuciFlashView puts the patched LuCI "Backup / Flash Firmware" view in
# place. The DMRHub package ships it under /usr/share/dmrhub; copying it here
# on every start keeps the section even when a LuCI update overwrites the
# file, because the copy happens after all packages are installed.
installLuciFlashView() {
    local src="/usr/share/dmrhub/flash.js"
    local dst="/www/luci-static/resources/view/system/flash.js"
    [ -f "$src" ] || return 0
    [ -d "$(dirname "$dst")" ] || return 0
    if ! cmp -s "$src" "$dst" 2>/dev/null; then
        cp "$src" "$dst" 2>/dev/null && echo "dmrhub: installed the LuCI OTA section"
    fi
}

# installLuciOverview keeps the traffic counters on the LuCI overview network
# box. Same idea as installLuciFlashView: the patched view ships under
# /usr/share/dmrhub and is copied over the package one on every start, so a
# LuCI update that overwrites it is undone at the next boot.
installLuciOverview() {
    local src="/usr/share/dmrhub/overview-network.js"
    local dst="/www/luci-static/resources/view/status/include/30_network.js"
    [ -f "$src" ] || return 0
    [ -d "$(dirname "$dst")" ] || return 0
    if ! cmp -s "$src" "$dst" 2>/dev/null; then
        cp "$src" "$dst" 2>/dev/null && echo "dmrhub: installed the LuCI overview traffic counters"
    fi
}

# keepDataOverUpgrade used to add /opt/dmrhub to /lib/upgrade/keep.d. The data
# partition is preserved by sysupgrade's partition-table comparison instead, so
# nothing of /opt/dmrhub belongs in the configuration archive.

status() {
    # Match the process name, not the full command line: pgrep -f also finds
    # the shell that runs this check, which makes the wait below never end.
    if pidof dmrhub >/dev/null 2>&1; then
        echo "DMRHub is running"
    else
        echo "DMRHub is not running"
    fi
}

# rc.common calls stop_service before procd_kill, so waiting here would only
# burn the grace period while DMRHub is still writing. The real wait belongs
# in service_stopped, which rc.common calls after procd_kill has sent TERM.
stop_service() {
    return 0
}

# service_stopped (defined above, after procd_close_instance) waits for the
# writer inside dmrhub-db-protect before it checkpoints the WAL and refreshes
# the snapshot. A second wait here used to shadow it and matched the rc.common
# wrapper through pidof, so the snapshot never ran: keep a single definition.
